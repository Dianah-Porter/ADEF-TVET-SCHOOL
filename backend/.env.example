# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ───────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Host port is 5433 to avoid clashing with a local
# Postgres already listening on 5432.
DATABASE_URL="postgresql://adef:adef_local_dev@localhost:5433/adef?schema=public"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate real values with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. The server refuses to start otherwise.
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# 5173 is the Vite dev server for the ADEF frontend.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Absolute base the API prefixes onto stored file paths when returning URLs.
PUBLIC_BASE_URL="http://localhost:4000"

# ─── Seed credentials ───────────────────────────────────────────────────────
# Used once by `npm run db:seed` to create the first administrator.
SEED_ADMIN_EMAIL="admin@adef.rw"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="ADEF Administrator"
