# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ───────────────────────────────────────────────────────────────
# Points at the PostgreSQL 18 service installed on this machine (default port
# 5432). Replace YOUR_PASSWORD with the password set for the "postgres" user
# during installation.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/adef?schema=public"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate real values with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. The server refuses to start otherwise.
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# 5173 is the Vite dev server for the ADEF frontend.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Absolute base the API prefixes onto stored file paths when returning URLs.
PUBLIC_BASE_URL="http://localhost:4000"

# ─── Seed credentials ───────────────────────────────────────────────────────
# Used once by `npm run db:seed` to create the first administrator.
SEED_ADMIN_EMAIL="admin@adef.rw"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="ADEF Administrator"

# ─── Dashboard URL ──────────────────────────────────────────────────────────
# Where the admin dashboard is served. Password reset links are built against
# this, so in production it must be the real site, not localhost.
APP_URL="http://localhost:5173"

# ─── Outgoing email ─────────────────────────────────────────────────────────
# All optional. Leave SMTP_HOST unset and the API prints password reset emails
# to the server console instead of sending them — which is what makes the reset
# flow testable locally with no mail server.
#
# Set these in production, or staff who forget their password cannot recover it.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="adeftvet@gmail.com"
# SMTP_PASS="your-app-password"
MAIL_FROM="ADEF TVET School <no-reply@adef.rw>"

# How long a password reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=60
