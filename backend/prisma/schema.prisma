// ADEF TVET School — database schema
// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads it here).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  EDITOR
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum AnnouncementType {
  NEWS
  EVENT
  NOTICE
}

/// Why a refresh token stopped being valid. Distinguishing these matters:
/// only a token revoked by ROTATION being replayed is evidence of theft.
enum RevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
}

// ─── Models ─────────────────────────────────────────────────────────────────

/// Staff who can sign in to the dashboard. Created by the seed or by a
/// SUPER_ADMIN — there is deliberately no public signup route.
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  galleryImages GalleryImage[]
  announcements Announcement[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  passwordResets PasswordResetToken[]

  @@map("admin_users")
}

/// One photo on the public gallery page.
model GalleryImage {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  caption  String?
  /// Required, not optional: a public gallery without alt text is inaccessible.
  altText  String
  category String  @default("General")

  /// Path within the storage driver. The driver, not the database, decides
  /// what that path physically means.
  storageKey   String  @unique
  url          String
  thumbnailKey String?
  thumbnailUrl String?

  width     Int
  height    Int
  sizeBytes Int
  mimeType  String

  /// Manual display order, set by dragging in the dashboard.
  sortOrder Int     @default(0)
  published Boolean @default(true)

  uploadedById String?    @db.Uuid
  /// Deleting a staff account must not delete the school's photos.
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
  @@map("gallery_images")
}

/// A text post, optionally carrying PDF documents.
model Announcement {
  id      String  @id @default(uuid()) @db.Uuid
  title   String
  /// Stable public identifier. Kept unchanged when the title is edited so
  /// links already shared with students keep working.
  slug    String  @unique
  /// Sanitised on write, so no consumer has to remember to escape it.
  body    String
  excerpt String?

  type   AnnouncementType   @default(NEWS)
  status AnnouncementStatus @default(DRAFT)
  pinned Boolean            @default(false)

  publishedAt DateTime?

  authorId String?    @db.Uuid
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, pinned, publishedAt])
  @@index([slug])
  @@map("announcements")
}

/// A PDF belonging to one announcement.
model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  /// The name the uploader gave it, used for the download filename.
  filename   String
  storageKey String @unique
  url        String
  mimeType   String
  sizeBytes  Int

  createdAt DateTime @default(now())

  @@index([announcementId])
  @@map("attachments")
}

/// Lets a session be revoked server-side. Only the hash is stored, so a
/// database leak does not hand over usable sessions.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  revokedAt    DateTime?
  revokedReason RevokeReason?
  userAgent    String?
  ip           String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Who changed what. Answers "who deleted that photo?" after the fact.
model AuditLog {
  id      String     @id @default(uuid()) @db.Uuid
  actorId String?    @db.Uuid
  actor   AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action   AuditAction
  entity   String
  entityId String?
  meta     Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Website content ────────────────────────────────────────────────────────
// Everything below is what the public site renders. It used to be hard-coded
// in the frontend; moving it here is what lets staff edit the site without a
// redeploy. Each model carries `sortOrder` and `published` for the same reason:
// the dashboard needs to reorder items and to take one off the site without
// destroying it.

/// Accent used by a card on the public site. An enum rather than a free-form
/// colour so staff cannot pick something that clashes with the school palette.
enum AccentColor {
  ORANGE
  GOLD
  NAVY
  CHARCOAL
}

enum CourseIcon {
  FLAME
  HAMMER
  BOX
}

enum FeatureIcon {
  AWARD
  HAND
  USERS
  WRENCH
  BRIEFCASE
}

/// A trade taught at the school, shown on the Courses section.
model Course {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  /// Stable public identifier, kept when the title is edited.
  slug        String  @unique
  description String
  level       String?
  duration    String?

  icon        CourseIcon  @default(FLAME)
  accentColor AccentColor @default(ORANGE)

  imageKey String?
  imageUrl String?

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("courses")
}

/// A graduate's quote on the Testimonials section.
model Testimonial {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  /// Free text such as "Welding L3 Graduate" — not a relation to Course,
  /// because a graduate's course may since have been renamed or removed and
  /// their quote should still read correctly.
  course String
  text   String
  rating Int    @default(5)

  avatarKey String?
  avatarUrl String?

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("testimonials")
}

/// One image in the rotating hero at the top of the site.
model HeroSlide {
  id       String  @id @default(uuid()) @db.Uuid
  headline String?
  subtext  String?

  storageKey String @unique
  imageUrl   String

  width     Int
  height    Int
  sizeBytes Int
  mimeType  String

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("hero_slides")
}

/// A selling point on the "Why choose ADEF" section.
model Feature {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String
  icon        FeatureIcon @default(AWARD)
  accentColor AccentColor @default(GOLD)

  sortOrder Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("features")
}

/// One row of the opening-hours table.
model WorkingHours {
  id  String @id @default(uuid()) @db.Uuid
  /// A label, not a weekday enum: the school publishes ranges such as
  /// "Monday – Saturday" as a single row.
  day String

  openTime  String
  closeTime String?
  /// False renders the day as "Closed" and hides the times.
  isOpen    Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("working_hours")
}

/// Single row of site-wide text and contact details.
///
/// A one-row table rather than a key/value store: the fields are a fixed,
/// known set, and this way they stay typed and the dashboard can render one
/// ordinary form instead of a list of untyped strings.
model SiteSettings {
  /// Always "site". The default is what makes upsert-by-id safe.
  id String @id @default("site")

  schoolName String
  tagline    String?

  vision  String
  mission String

  aboutTitle String?
  aboutText  String
  aboutText2 String?

  graduatesCount String
  programsCount  Int

  phone    String
  whatsapp String?
  email    String
  address  String

  mapEmbedUrl  String?
  instagramUrl String?
  twitterUrl   String?

  workingHoursNote String?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

/// An enquiry submitted through the website's contact form.
model ContactMessage {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  email   String
  phone   String?
  message String

  status ContactStatus @default(NEW)

  /// Kept for abuse investigation, not shown in the dashboard.
  ip        String?
  userAgent String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("contact_messages")
}

/// A single-use password reset link.
///
/// Like refresh tokens, only the hash is stored: the plaintext exists solely
/// inside the email that was sent, so a database leak cannot be used to take
/// over accounts.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
