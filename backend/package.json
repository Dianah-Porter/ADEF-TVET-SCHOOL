{
  "name": "adef-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API and admin backend for the ADEF TVET School website",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js src",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset",
    "test:smoke": "node node_modules/tsx/dist/cli.mjs scripts/smoke-test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
