{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",

  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
